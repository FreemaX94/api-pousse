{
  "name": "api-pousse-backend",
  "version": "1.0.0",
  "main": "index.js",
  "engines": {
    "node": ">=18.x",
    "npm": ">=8.x"
  },
  "scripts": {
    "start": "npm install && echo '🚨 COPYING FRONTEND FILES' && cp -r ../frontend/dist/* . 2>/dev/null || echo 'No frontend dist to copy' && node --enable-source-maps index.js",
    "dev": "node --enable-source-maps index.js",
    "dev-simple": "node --enable-source-maps index.js",
    "build-docs": "swagger-jsdoc -d swagger.js -o swagger.json",
    "import:catalogue": "node importCatalogueFromExcel.js ./data/catalogue.xlsx",
    "import:stock": "node importStockExcel.js ./data/stock.xlsx",
    "seed:concepteurs": "node initConcepteurs.js",
    "test": "jest --config jest.config.cjs --coverage",
    "test:api": "node test_api_endpoints.js",
    "lint": "eslint .",
    "production-check": "node scripts/production-check.js",
    "start:prod": "NODE_ENV=production npm start",
    "final-check": "node scripts/final-check.js",
    "validate": "node scripts/validation-complete.js",
    "build": "echo 'Backend build - Frontend will be copied from frontend build'",
    "security-audit": "node ../security-audit.js",
    "security-check": "npm audit --audit-level=moderate",
    "setup-superadmin": "node scripts/setup-superadmin.js",
    "init-rbac": "node -e \"require('./services/rbacService').initializeRBAC().then(() => process.exit(0)).catch(console.error)\""
  },
  "dependencies": {
    "@hapi/hoek": "^11.0.7",
    "@newrelic/winston-enricher": "^4.0.1",
    "@swc/helpers": "^0.5.17",
    "axios": "^1.10.0",
    "axios-retry": "^4.5.0",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^3.0.2",
    "celebrate": "^15.0.1",
    "chalk": "^4.1.2",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "exceljs": "^4.4.0",
    "express": "^4.18.2",
    "express-async-handler": "^1.2.0",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^8.0.1",
    "express-session": "^1.18.2",
    "express-validator": "^7.2.1",
    "form-data": "^4.0.4",
    "googleapis": "^149.0.0",
    "helmet": "^8.1.0",
    "http-errors": "^2.0.0",
    "joi": "^17.13.3",
    "json2csv": "^6.0.0-alpha.2",
    "jsonwebtoken": "^9.0.2",
    "lodash": "^4.17.21",
    "moment": "^2.30.1",
    "mongoose": "^8.16.4",
    "mongoose-paginate-v2": "^1.9.1",
    "morgan": "^1.10.0",
    "multer": "^2.0.2",
    "newrelic": "^12.25.0",
    "node-cache": "^5.1.2",
    "nodemailer": "^7.0.5",
    "pdfkit": "^0.17.1",
    "redis": "^4.7.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^4.6.0",
    "tslib": "^2.8.1",
    "validator": "^13.15.15",
    "winston": "^3.17.0",
    "winston-daily-rotate-file": "^5.0.0",
    "xlsx": "^0.18.5",
    "xss": "^1.0.15"
  },
  "devDependencies": {
    "@babel/core": "^7.21.0",
    "@babel/preset-env": "^7.21.0",
    "babel-jest": "^29.5.0",
    "colors": "^1.4.0",
    "eslint": "^8.43.0",
    "ioredis-mock": "^8.9.0",
    "jest": "^30.0.5",
    "node-mocks-http": "^1.17.2",
    "nodemon": "^3.1.10",
    "supertest": "^7.1.4"
  },
  "directories": {
    "test": "tests"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": ""
}
